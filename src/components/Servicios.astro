---
const servicios = [
  {
    num: "01",
    title: "Transformación digital",
    desc: "Seleccionamos, proveemos e implementamos el software y las tecnologías que ordenan la operación y liberan capacidad real de tu equipo.",
    icon: `<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>`,
  },
  {
    num: "02",
    title: "Consultoría estratégica",
    desc: "Diagnosticamos el negocio, definimos prioridades y trazamos una hoja de ruta para crecer con decisiones respaldadas por datos.",
    icon: `<circle cx="12" cy="12" r="9"/><path d="m15 9-3.5 1.5L10 14l3.5-1.5L15 9Z"/>`,
  },
  {
    num: "03",
    title: "Consultoría de procesos",
    desc: "Identificamos los cuellos de botella y rediseñamos la operación para convertir la fricción en eficiencia medible.",
    icon: `<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.5 6H15a3 3 0 0 1 3 3v6.5M6 8.5V15a3 3 0 0 0 3 3h6.5"/>`,
  },
  {
    num: "04",
    title: "Red de alianzas estratégicas",
    desc: "Te damos acceso a capacidades técnicas y socios que, de forma independiente, tardarías años en desarrollar.",
    icon: `<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M12 7.5 6.5 16M12 7.5 17.5 16M7.5 18h9"/>`,
  },
];
---

<section id="servicios" class="bg-hueso py-24 md:py-32">
  <div class="shell">
    <div class="reveal max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-medio">Lo que hacemos</span>
      <h2 class="mt-4 text-[clamp(2rem,4vw,3rem)] text-profundo">
        Cuatro capacidades, un mismo objetivo
      </h2>
      <p class="mt-5 text-[1.06rem] text-gris">
        Diseñamos soluciones integrales y las implementamos junto a tu equipo, no en paralelo a él.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        servicios.map((s, i) => (
          <article
            class={`reveal group relative overflow-hidden rounded-2xl border border-borde bg-white p-8 transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-[var(--shadow-soft)] md:p-9 ${i % 2 === 1 ? "d1" : ""}`}
          >
            <span class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-menta transition-transform duration-300 group-hover:scale-x-100" />
            <div class="flex items-start justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-menta/15 text-verde transition-colors duration-300 group-hover:bg-verde group-hover:text-white">
                <svg
                  viewBox="0 0 24 24"
                  class="h-6 w-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={s.icon}
                />
              </span>
              <span class="font-display text-sm font-semibold tracking-[0.08em] text-menta">
                {s.num}
              </span>
            </div>
            <h3 class="mt-6 font-display text-[1.35rem] font-bold text-verde">{s.title}</h3>
            <p class="mt-3 text-[0.99rem] leading-relaxed text-gris">{s.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
