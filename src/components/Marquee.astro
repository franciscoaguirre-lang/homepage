---
const items = [
  "Transformación digital",
  "Consultoría estratégica",
  "Optimización de procesos",
  "Ingeniería de sistemas",
  "Red de alianzas",
  "Servitización",
];
// Se duplica la lista para un desplazamiento continuo sin cortes.
const loop = [...items, ...items];
---

<div class="border-y border-borde bg-hueso py-5">
  <div
    class="relative flex overflow-hidden"
    style="mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)"
  >
    <ul class="marquee-track flex shrink-0 items-center gap-10 pr-10" aria-hidden="true">
      {
        loop.map((item) => (
          <li class="flex items-center gap-10">
            <span class="whitespace-nowrap font-display text-sm font-semibold uppercase tracking-[0.14em] text-verde/70">
              {item}
            </span>
            <span class="h-1.5 w-1.5 rotate-45 bg-menta"></span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
