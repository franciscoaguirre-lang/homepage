---
import { CONTACT } from "../consts";

const mailIcon = `<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>`;
const waIcon = `<path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-4-1L3 21l2.2-4.8A8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"/>`;
const liIcon = `<rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 10v7M7 7v.01M12 17v-4a2 2 0 0 1 4 0v4"/>`;

const canales = [
  {
    label: "Correo",
    value: CONTACT.email,
    href: CONTACT.email ? `mailto:${CONTACT.email}` : "",
    external: false,
    icon: mailIcon,
  },
  ...CONTACT.whatsapps.map((w) => ({
    label: "WhatsApp",
    value: w.label,
    href: `https://wa.me/${w.e164}`,
    external: true,
    icon: waIcon,
  })),
  {
    label: "LinkedIn",
    value: CONTACT.linkedin ? "Perfil de ASSID" : "",
    href: CONTACT.linkedin,
    external: true,
    icon: liIcon,
  },
];
---

<section id="contacto" class="bg-white py-24 md:py-32">
  <div class="shell grid gap-16 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
    <div class="reveal">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-medio">Contáctanos</span>
      <h2 class="mt-4 text-[clamp(2rem,4vw,3rem)] text-profundo">Conversemos sobre tu operación</h2>
      <p class="mt-5 max-w-md text-[1.06rem] text-gris">
        Cuéntanos qué necesita tu empresa. La primera conversación es sin costo y sirve para entender
        si podemos aportar valor real.
      </p>

      <div
        class="mt-8 inline-flex items-center gap-3 rounded-xl border border-borde bg-hueso px-5 py-4"
      >
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-menta/20">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="#25623b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </span>
        <p class="text-sm text-gris">
          <strong class="font-semibold text-tinta">Sin compromiso.</strong> Respondemos rápido y hablamos claro.
        </p>
      </div>
    </div>

    <div class="reveal d1 grid gap-4 sm:grid-cols-2">
      {
        canales.map((c) => {
          const available = Boolean(c.href);
          const Tag = available ? "a" : "div";
          return (
            <Tag
              href={available ? c.href : undefined}
              target={available && c.external ? "_blank" : undefined}
              rel={available && c.external ? "noopener" : undefined}
              class:list={[
                "group flex items-center gap-4 rounded-2xl border border-borde bg-white p-5 transition-[transform,border-color,box-shadow] duration-300",
                available
                  ? "hover:-translate-y-1 hover:border-medio hover:shadow-[var(--shadow-soft)]"
                  : "opacity-70",
              ]}
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-menta/15 text-verde transition-colors duration-300 group-hover:bg-verde group-hover:text-white">
                <svg
                  viewBox="0 0 24 24"
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={c.icon}
                />
              </span>
              <span class="min-w-0">
                <span class="block text-xs font-semibold uppercase tracking-[0.12em] text-gris">
                  {c.label}
                </span>
                <span class="block truncate font-semibold text-tinta">
                  {available ? c.value : "Disponible pronto"}
                </span>
              </span>
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>
