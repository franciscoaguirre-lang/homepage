---
const pasos = [
  {
    num: "01",
    title: "Diagnóstico",
    desc: "Entendemos tu operación, tu negocio y tus objetivos. Escuchamos antes de proponer.",
  },
  {
    num: "02",
    title: "Hoja de ruta",
    desc: "Priorizamos lo que genera impacto y definimos un plan claro, medible y realista.",
  },
  {
    num: "03",
    title: "Implementación",
    desc: "Ejecutamos junto a tu equipo, transfiriendo capacidades para que queden dentro de la casa.",
  },
  {
    num: "04",
    title: "Servicio continuo",
    desc: "Acompañamos, medimos y evolucionamos. El crecimiento no se detiene en la entrega.",
  },
];
---

<section id="metodo" class="bg-white py-24 md:py-32">
  <div class="shell">
    <div class="reveal max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-medio">Cómo trabajamos</span>
      <h2 class="mt-4 text-[clamp(2rem,4vw,3rem)] text-profundo">
        Junto a tu equipo, no en paralelo a él
      </h2>
      <p class="mt-5 text-[1.06rem] text-gris">
        Un método simple y transparente, pensado para que las capacidades queden en tu operación.
      </p>
    </div>

    <ol class="relative mt-14 grid gap-8 md:grid-cols-4 md:gap-6">
      <!-- Línea conectora (desktop) -->
      <span
        class="pointer-events-none absolute left-0 right-0 top-6 hidden h-px bg-borde md:block"
        aria-hidden="true"></span>

      {
        pasos.map((p, i) => (
          <li class={`reveal relative ${i === 1 ? "d1" : i === 2 ? "d2" : i === 3 ? "d3" : ""}`}>
            <div class="flex items-center gap-4 md:block">
              <span class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-borde bg-white font-display text-sm font-bold text-verde shadow-[0_4px_14px_rgba(18,39,27,0.06)]">
                {p.num}
              </span>
              <h3 class="font-display text-xl font-bold text-tinta md:mt-5">{p.title}</h3>
            </div>
            <p class="mt-3 pl-16 text-[0.98rem] leading-relaxed text-gris md:pl-0">{p.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
