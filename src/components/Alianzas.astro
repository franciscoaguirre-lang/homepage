---
const puntos = [
  {
    k: "Capacidades",
    title: "Talento técnico de alto nivel",
    desc: "Accedes a especialistas y equipos que, por tu cuenta, sería costoso y lento incorporar.",
  },
  {
    k: "Tecnología",
    title: "Herramientas de vanguardia",
    desc: "Integramos software y tecnologías que de forma independiente estarían fuera de tu alcance.",
  },
  {
    k: "Crecimiento",
    title: "Oportunidades exponenciales",
    desc: "Te conectamos a un ecosistema de negocios activo, interconectado y en constante evolución.",
  },
];
---

<section id="alianzas" class="relative overflow-hidden bg-profundo py-24 text-white md:py-32">
  <div class="dot-grid-light pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -bottom-40 -left-28 h-[36rem] w-[36rem] rounded-full"
    style="background:radial-gradient(circle,rgba(85,223,135,0.14) 0%,transparent 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative grid items-start gap-14 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="reveal">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-menta">
        Red de alianzas estratégicas
      </span>
      <h2 class="mt-4 text-[clamp(2rem,4vw,3rem)] text-white">
        Una red que te tomaría años construir
      </h2>
      <div class="mt-7 h-1 w-16 bg-menta"></div>
      <p class="mt-7 max-w-md text-[1.06rem] leading-relaxed text-white/75">
        No te limitamos a lo que ASSID hace por sí sola. Orquestamos una red de socios para que
        accedas a herramientas, tecnologías y oportunidades de crecimiento que, de forma
        independiente, tardarías años en desarrollar.
      </p>
      <a href="#contacto" class="btn btn-light mt-9">
        Quiero acceder a la red
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
        >
      </a>
    </div>

    <div class="flex flex-col gap-4">
      {
        puntos.map((p, i) => (
          <article
            class={`reveal flex items-start gap-5 rounded-2xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur-sm transition-colors hover:border-menta/40 md:p-7 ${i === 1 ? "d1" : i === 2 ? "d2" : ""}`}
          >
            <span class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-menta/15 font-display text-sm font-bold text-menta">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-menta/80">{p.k}</p>
              <h3 class="mt-1 font-display text-lg font-bold text-white">{p.title}</h3>
              <p class="mt-2 text-[0.97rem] leading-relaxed text-white/70">{p.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
