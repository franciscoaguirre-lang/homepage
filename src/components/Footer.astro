---
import Logo from "./Logo.astro";
import { SITE, CONTACT, NAV } from "../consts";
---

<footer class="bg-profundo text-white/60">
  <div class="shell py-14">
    <div
      class="flex flex-col gap-8 border-b border-white/10 pb-10 md:flex-row md:items-start md:justify-between"
    >
      <div class="max-w-sm">
        <Logo variant="light" markClass="h-8" wordClass="text-[1.3rem]" />
        <p class="mt-4 text-sm leading-relaxed text-white/55">
          {SITE.tagline} · Chile.<br />
          El motor que acelera la evolución de las industrias.
        </p>
      </div>

      <nav class="flex flex-col gap-3 text-sm" aria-label="Navegación del pie">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-menta"
          >Navegación</span
        >
        {
          NAV.map((item) => (
            <a href={item.href} class="text-white/65 transition-colors hover:text-white">
              {item.label}
            </a>
          ))
        }
        <a href="#contacto" class="text-white/65 transition-colors hover:text-white">Contacto</a>
      </nav>

      <div class="flex flex-col gap-3 text-sm">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-menta">Contacto</span>
        {
          CONTACT.email ? (
            <a
              href={`mailto:${CONTACT.email}`}
              class="text-white/65 transition-colors hover:text-white"
            >
              {CONTACT.email}
            </a>
          ) : (
            <span class="text-white/45">Correo · disponible pronto</span>
          )
        }
        {
          CONTACT.whatsapp ? (
            <a
              href={`https://wa.me/${CONTACT.whatsapp}`}
              target="_blank"
              rel="noopener"
              class="text-white/65 transition-colors hover:text-white"
            >
              WhatsApp {CONTACT.whatsappLabel}
            </a>
          ) : (
            <span class="text-white/45">WhatsApp · disponible pronto</span>
          )
        }
        <span class="text-white/45">{SITE.domain}</span>
      </div>
    </div>

    <div
      class="flex flex-col gap-2 pt-8 text-xs text-white/45 md:flex-row md:items-center md:justify-between"
    >
      <p>© <span id="year">2026</span> {SITE.name}. Todos los derechos reservados.</p>
      <p class="italic text-menta/70">{SITE.signature}.</p>
    </div>
  </div>
</footer>
